{
  "name": "vika-cli",
  "version": "0.1.0",
  "description": "Finds error patterns that first appeared after a deploy and names the suspect commit/PR.",
  "type": "module",
  "license": "MIT",
  "bin": {
    "vika": "dist/cli.js"
  },
  "files": [
    "dist",
    "migrations",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=20.12"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "prepublishOnly": "rm -rf dist && npm run build",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "demo:fixture": "tsx scripts/build-demo-fixture.ts",
    "demo:reset": "tsx scripts/reset-demo-fixture.ts"
  },
  "dependencies": {
    "commander": "^15.1.0",
    "pg": "^8.23.1",
    "yaml": "^2.9.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@types/pg": "^8.23.1",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.1.1"
  }
}